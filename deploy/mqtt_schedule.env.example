MQTT_SCHEDULE_MQTT_USERNAME=
MQTT_SCHEDULE_MQTT_PASSWORD=
MQTT_SCHEDULE_ACCESS_GROUPS=
MQTT_SCHEDULE_AIRTABLE_API_KEY=
# Optional startup fetches; all default to false in runtime.json.
# MQTT_SCHEDULE_AIRTABLE_CONTROLLER_SYNC_RUN_IMMEDIATELY=true
# MQTT_SCHEDULE_AIRTABLE_SCHEDULE_SYNC_RUN_IMMEDIATELY=true
# MQTT_SCHEDULE_AIRTABLE_ACCESS_USERS_SYNC_RUN_IMMEDIATELY=true
MQTT_SCHEDULE_OPENWEATHER_API_KEY=
MQTT_SCHEDULE_TEMPEST_TOKEN=
# Twilio SMS credentials. Enable sends only through sms_enabled in runtime.json.
# Set real values only in /etc/mqtt_schedule/mqtt_schedule.env on the server.
MQTT_SCHEDULE_TWILIO_ACCOUNT_SID=
MQTT_SCHEDULE_TWILIO_AUTH_TOKEN=
MQTT_SCHEDULE_TWILIO_FROM_NUMBER=
MQTT_SCHEDULE_TWILIO_TO_NUMBERS=
# Reserved for a future email adapter; currently not consumed by the application.
# Keep real addresses and passwords in the protected server environment file.
MQTT_SCHEDULE_SENDER_EMAIL_ADDRESS=
MQTT_SCHEDULE_EMAIL_PASSWORD=
MQTT_SCHEDULE_RECEIVER_EMAIL_ADDRESS_1=
MQTT_SCHEDULE_RECEIVER_EMAIL_ADDRESS_2=
MQTT_SCHEDULE_MONGO_URI=
MQTT_SCHEDULE_MONGO_AUTHENTICATE=
MQTT_SCHEDULE_MONGO_USERNAME=
MQTT_SCHEDULE_MONGO_PASSWORD=
MQTT_SCHEDULE_MONGO_OPENWEATHER_INGEST_RUN_IMMEDIATELY=
MQTT_SCHEDULE_MONGO_TEMPEST_INGEST_RUN_IMMEDIATELY=
MQTT_SCHEDULE_WEATHER_REFRESH_RUN_IMMEDIATELY=
# Optional commissioning safety filter. Comma-separated destination serials.
MQTT_SCHEDULE_ONLY_DESTINATIONS=
# Optional test-only override. Leave empty in production.
MQTT_SCHEDULE_SOURCE_SERIAL_OVERRIDE=
